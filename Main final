import threading
import time
import RPi.GPIO as GPIO
from relay_polarity_control import PolarityRelayController
from relay_stepper_control import RelayStepperController
from sunset_sunrise_control import SunriseSunsetController
from motion_sound_system import motion_handler
from event_logger import log_event

# -------------------------------
# GPIO Reset and Setup
# -------------------------------
try:
    GPIO.cleanup()
except:
    pass

GPIO.setmode(GPIO.BCM)
GPIO.setwarnings(False)

LIMIT_SWITCH_PIN = 23
IR_SENSOR_PIN = 22
AUTO_MANUAL_SWITCH_PIN = 24   # New: Switch for Auto/Manual mode
DAY_NIGHT_SWITCH_PIN = 25     # New: Switch for Day/Night in Manual Mode

GPIO.setup(LIMIT_SWITCH_PIN, GPIO.IN, pull_up_down=GPIO.PUD_UP)
GPIO.setup(IR_SENSOR_PIN, GPIO.IN, pull_up_down=GPIO.PUD_UP)
GPIO.setup(AUTO_MANUAL_SWITCH_PIN, GPIO.IN, pull_up_down=GPIO.PUD_UP)
GPIO.setup(DAY_NIGHT_SWITCH_PIN, GPIO.IN, pull_up_down=GPIO.PUD_UP)

# -------------------------------
# Initialize components
# -------------------------------
actuator = PolarityRelayController()
stepper = RelayStepperController()
sun = SunriseSunsetController()

# -------------------------------
# Coop and system state
# -------------------------------
coop_closed = True
combo_count = 0
manual_mode = False
manual_daytime = True

# -------------------------------
# Functions
# -------------------------------

def open_coop():
    global coop_closed
    if not coop_closed:
        print("[COOP] Already open.")
        return
    print("[COOP] Opening...")
    actuator.retract()
    time.sleep(15)
    actuator.stop()
    stepper.power_on()
    stepper.rotate("cw", 5.25)
    stepper.power_off()
    coop_closed = False
    log_event("Coop Opened", "Daytime")

def close_coop():
    global coop_closed
    if coop_closed:
        print("[COOP] Already closed.")
        return
    print("[COOP] Closing...")
    actuator.extend()
    time.sleep(15)
    actuator.stop()
    stepper.power_on()
    stepper.rotate("ccw", 5.25)
    stepper.power_off()
    coop_closed = True
    log_event("Coop Closed", "Nighttime")

def auto_day_night_monitor():
    print("[AUTO] Starting day/night cycle monitoring...")
    while True:
        if not manual_mode:  # Only when in Auto Mode
            if sun.needs_update():
                sun.fetch_sun_times()

            state = sun.check_sun_times()
            if state == "open":
                open_coop()
            elif state == "close":
                close_coop()
            time.sleep(30)
        else:
            time.sleep(5)  # Sleep if manual mode is active

def combo_counter_monitor():
    global combo_count
    print("[COMBO] Monitoring combo counter...")
    while True:
        if manual_mode and manual_daytime:
            # Only count during manual mode + daytime
            if GPIO.input(IR_SENSOR_PIN) == GPIO.LOW:
                ir_triggered = True
                print("[COMBO] IR triggered. Waiting for Limit Switch...")
                start_time = time.time()

                while time.time() - start_time < 2:  # 2 seconds window
                    if GPIO.input(LIMIT_SWITCH_PIN) == GPIO.LOW:
                        print("[COMBO] Limit Switch triggered. Valid chicken.")
                        combo_count += 1
                        log_event("Combo Chicken Count", f"Combo Count: {combo_count}")
                        time.sleep(0.5)
                        break
                    time.sleep(0.05)

            elif GPIO.input(LIMIT_SWITCH_PIN) == GPIO.LOW:
                limit_triggered = True
                print("[COMBO] Limit Switch triggered. Waiting for IR...")
                start_time = time.time()

                while time.time() - start_time < 2:  # 2 seconds window
                    if GPIO.input(IR_SENSOR_PIN) == GPIO.LOW:
                        print("[COMBO] IR triggered. Valid chicken.")
                        combo_count += 1
                        log_event("Combo Chicken Count", f"Combo Count: {combo_count}")
                        time.sleep(0.5)
                        break
                    time.sleep(0.05)

            time.sleep(0.05)
        else:
            time.sleep(2)  # Sleep longer if not manual daytime

def motion_detector_monitor():
    print("[MOTION] Monitoring motion detection...")
    while True:
        if manual_mode and not manual_daytime:
            try:
                motion_handler()
            except KeyboardInterrupt:
                print("[MOTION] Motion handler interrupted.")
        else:
            time.sleep(2)  # Sleep if not manual nighttime

def mode_manager():
    global manual_mode, manual_daytime
    print("[MODE] Managing Auto/Manual and Day/Night switches...")
    last_auto_manual_state = GPIO.input(AUTO_MANUAL_SWITCH_PIN)
    last_day_night_state = GPIO.input(DAY_NIGHT_SWITCH_PIN)

    while True:
        # Check Auto/Manual Switch
        current_auto_manual = GPIO.input(AUTO_MANUAL_SWITCH_PIN)
        if current_auto_manual != last_auto_manual_state:
            manual_mode = (current_auto_manual == GPIO.LOW)
            if manual_mode:
                print("[MODE] Switched to MANUAL mode.")
            else:
                print("[MODE] Switched to AUTO mode.")
            last_auto_manual_state = current_auto_manual
            time.sleep(0.5)

        # Check Day/Night Switch only if in Manual Mode
        if manual_mode:
            current_day_night = GPIO.input(DAY_NIGHT_SWITCH_PIN)
            if current_day_night != last_day_night_state:
                manual_daytime = (current_day_night == GPIO.LOW)
                if manual_daytime:
                    print("[MODE] Set to MANUAL DAYTIME.")
                    open_coop()
                else:
                    print("[MODE] Set to MANUAL NIGHTTIME.")
                    close_coop()
                last_day_night_state = current_day_night
                time.sleep(0.5)

        time.sleep(0.1)

def run_all_modules():
    threads = [
        threading.Thread(target=auto_day_night_monitor),
        threading.Thread(target=motion_detector_monitor),
        threading.Thread(target=combo_counter_monitor),
        threading.Thread(target=mode_manager),
    ]
    for t in threads:
        t.start()
    for t in threads:
        t.join()

# -------------------------------
# Program Start
# -------------------------------
if __name__ == "__main__":
    try:
        run_all_modules()
    except KeyboardInterrupt:
        print("[EXIT] System shutting down...")
        GPIO.cleanup()
