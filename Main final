import threading
import time
import RPi.GPIO as GPIO
from relay_polarity_control import PolarityRelayController
from relay_stepper_control import RelayStepperController
from sunset_sunrise_control import SunriseSunsetController
from motion_sound_system import flash_light, play_random_sound, motion_handler
from sprayer import spray_water
from event_logger import log_event

# Setup GPIO
GPIO.setmode(GPIO.BCM)
GPIO.setwarnings(False)

# Switches
MODE_SWITCH_PIN = 13  # Auto/Manual Switch
DAY_NIGHT_SWITCH_PIN = 4  # Day/Night when in Manual

# Sensors
LIMIT_SWITCH_PIN = 23
IR_SENSOR_PIN = 22

# Setup Inputs
GPIO.setup(MODE_SWITCH_PIN, GPIO.IN, pull_up_down=GPIO.PUD_UP)
GPIO.setup(DAY_NIGHT_SWITCH_PIN, GPIO.IN, pull_up_down=GPIO.PUD_UP)
GPIO.setup(LIMIT_SWITCH_PIN, GPIO.IN, pull_up_down=GPIO.PUD_UP)
GPIO.setup(IR_SENSOR_PIN, GPIO.IN)

# Components
actuator = PolarityRelayController()
stepper = RelayStepperController()
sun = SunriseSunsetController()

# State variables
auto_mode = True
daytime_manual = True
coop_closed = True
combo_count = 0
motion_thread = None
motion_active = False

def open_coop():
    global coop_closed
    if not coop_closed:
        print("[COOP] Already open.")
        return
    print("[COOP] Opening coop...")
    actuator.retract()
    time.sleep(15)
    actuator.stop()
    stepper.power_on()
    stepper.rotate("cw", 5.25)
    stepper.power_off()
    coop_closed = False
    log_event("Coop Opened", "Daytime")

def close_coop():
    global coop_closed
    if coop_closed:
        print("[COOP] Already closed.")
        return
    print("[COOP] Closing coop...")
    actuator.extend()
    time.sleep(15)
    actuator.stop()
    stepper.power_on()
    stepper.rotate("ccw", 5.25)
    stepper.power_off()
    coop_closed = True
    log_event("Coop Closed", "Nighttime")

def combo_counter_monitor():
    global combo_count
    print("[COMBO] Combo Counter Active (IR + Limit Switch)...")
    while True:
        ir_triggered = False
        limit_triggered = False
        start_time = None

        if GPIO.input(IR_SENSOR_PIN) == GPIO.LOW:
            ir_triggered = True
            start_time = time.time()
            print("[COMBO] IR triggered, waiting for Limit Switch...")
        elif GPIO.input(LIMIT_SWITCH_PIN) == GPIO.LOW:
            limit_triggered = True
            start_time = time.time()
            print("[COMBO] Limit Switch triggered, waiting for IR...")

        if start_time:
            while time.time() - start_time < 2:
                if not limit_triggered and GPIO.input(LIMIT_SWITCH_PIN) == GPIO.LOW:
                    limit_triggered = True
                    print("[COMBO] Limit Switch triggered!")

                if not ir_triggered and GPIO.input(IR_SENSOR_PIN) == GPIO.LOW:
                    ir_triggered = True
                    print("[COMBO] IR triggered!")

                if ir_triggered and limit_triggered:
                    combo_count += 1
                    print(f"[COMBO] Valid chicken detected! Total: {combo_count}")
                    log_event("Combo Chicken Count", f"Combo Count: {combo_count}")
                    time.sleep(2)
                    break

                time.sleep(0.05)

            if not (ir_triggered and limit_triggered):
                print("[COMBO] False count detected.")
                log_event("Combo Count Failed", "False trigger or timeout")

        time.sleep(0.1)

def start_motion_monitor():
    global motion_thread, motion_active
    if motion_active:
        print("[MOTION] Motion monitoring already active.")
        return
    print("[MOTION] Starting motion monitoring...")
    motion_active = True
    motion_thread = threading.Thread(target=motion_handler)
    motion_thread.daemon = True
    motion_thread.start()

def stop_motion_monitor():
    global motion_active
    if motion_active:
        print("[MOTION] Stopping motion monitoring...")
        motion_active = False
        GPIO.cleanup()
        time.sleep(1)

def check_mode_switch():
    return GPIO.input(MODE_SWITCH_PIN) == GPIO.LOW

def check_day_night_switch():
    return GPIO.input(DAY_NIGHT_SWITCH_PIN) == GPIO.LOW

def auto_day_night_monitor():
    print("[AUTO] Auto Day/Night monitoring active...")
    global coop_closed

    while auto_mode:
        if sun.needs_update():
            sun.fetch_sun_times()

        state = sun.check_sun_times()
        if state == "open":
            open_coop()
            combo_counter_monitor()
        elif state == "close":
            close_coop()
            start_motion_monitor()
        time.sleep(30)

def manual_day_night_monitor():
    print("[MANUAL] Manual Day/Night monitoring active...")
    global daytime_manual

    while not auto_mode:
        if check_day_night_switch():
            if not daytime_manual:
                daytime_manual = True
                print("[MANUAL] Switched to DAYTIME manually.")
                open_coop()
        else:
            if daytime_manual:
                daytime_manual = False
                print("[MANUAL] Switched to NIGHTTIME manually.")
                close_coop()

        if daytime_manual:
            combo_counter_monitor()
        else:
            start_motion_monitor()

        time.sleep(1)

def main_loop():
    global auto_mode, daytime_manual

    print("[SYSTEM] Starting main system...")
    open_coop()

    while True:
        current_mode = check_mode_switch()

        if current_mode and not auto_mode:
            print("[SYSTEM] Switching to AUTO MODE")
            auto_mode = True
            stop_motion_monitor()
            open_coop()
            threading.Thread(target=auto_day_night_monitor).start()

        elif not current_mode and auto_mode:
            print("[SYSTEM] Switching to MANUAL MODE")
            auto_mode = False
            stop_motion_monitor()
            open_coop()
            threading.Thread(target=manual_day_night_monitor).start()

        time.sleep(1)

if __name__ == "__main__":
    try:
        main_loop()
    except KeyboardInterrupt:
        print("[EXIT] Shutting down system...")
        GPIO.cleanup()
