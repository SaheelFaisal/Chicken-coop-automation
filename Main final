import threading
import time
import RPi.GPIO as GPIO
from relay_polarity_control import PolarityRelayController
from relay_stepper_control import RelayStepperController
from sunset_sunrise_control import SunriseSunsetController
from motion_sound_system import motion_handler
from event_logger import log_event

# === GPIO Setup ===
GPIO.setmode(GPIO.BCM)
GPIO.setwarnings(False)

AUTO_MANUAL_SWITCH_PIN = 24  # Physical pin 18 (Button 13)
DAY_NIGHT_SWITCH_PIN = 25    # Physical pin 22 (Button 4)
LIMIT_SWITCH_PIN = 23
IR_SENSOR_PIN = 22

GPIO.setup(AUTO_MANUAL_SWITCH_PIN, GPIO.IN, pull_up_down=GPIO.PUD_UP)
GPIO.setup(DAY_NIGHT_SWITCH_PIN, GPIO.IN, pull_up_down=GPIO.PUD_UP)
GPIO.setup(LIMIT_SWITCH_PIN, GPIO.IN, pull_up_down=GPIO.PUD_UP)
GPIO.setup(IR_SENSOR_PIN, GPIO.IN)

# === Components ===
actuator = PolarityRelayController()
stepper = RelayStepperController()
sun = SunriseSunsetController()

# === Global Variables ===
mode_auto = True  # Start in Auto mode
simulated_daytime = True  # Used only in Manual mode
combo_count = 0

coop_closed = True

# === Functions ===

def open_coop():
    global coop_closed
    if not coop_closed:
        print("[COOP] Already open.")
        return
    print("[COOP] Opening...")
    actuator.retract()
    time.sleep(15)
    actuator.stop()
    stepper.power_on()
    stepper.rotate("cw", 5.25)
    stepper.power_off()
    coop_closed = False
    log_event("Coop Opened", "Daytime")

def close_coop():
    global coop_closed
    if coop_closed:
        print("[COOP] Already closed.")
        return
    print("[COOP] Closing...")
    actuator.extend()
    time.sleep(15)
    actuator.stop()
    stepper.power_on()
    stepper.rotate("ccw", 5.25)
    stepper.power_off()
    coop_closed = True
    log_event("Coop Closed", "Nighttime")

def combo_counter_monitor():
    global combo_count
    print("[COMBO] Monitoring combo counter...")
    while True:
        if (mode_auto and sun.check_sun_times() == "open") or (not mode_auto and simulated_daytime):
            ir_triggered = False
            limit_triggered = False
            start_time = None

            # Wait for either IR or Limit
            if GPIO.input(IR_SENSOR_PIN) == GPIO.LOW:
                ir_triggered = True
                start_time = time.time()
                print("[COMBO] IR triggered first, waiting for Limit Switch...")
            elif GPIO.input(LIMIT_SWITCH_PIN) == GPIO.LOW:
                limit_triggered = True
                start_time = time.time()
                print("[COMBO] Limit Switch triggered first, waiting for IR...")

            # Once one triggered, wait for the other
            if start_time:
                timeout = 2
                while time.time() - start_time < timeout:
                    if not limit_triggered and GPIO.input(LIMIT_SWITCH_PIN) == GPIO.LOW:
                        limit_triggered = True
                        print("[COMBO] Limit Switch triggered!")

                    if not ir_triggered and GPIO.input(IR_SENSOR_PIN) == GPIO.LOW:
                        ir_triggered = True
                        print("[COMBO] IR triggered!")

                    if ir_triggered and limit_triggered:
                        combo_count += 1
                        print(f"[COMBO] Valid chicken detected! Total: {combo_count}")
                        log_event("Combo Chicken Count", f"Combo Count: {combo_count}")
                        time.sleep(5)
                        break
                    time.sleep(0.05)
            else:
                time.sleep(0.1)

        else:
            time.sleep(2)

def motion_monitor():
    print("[MOTION] Monitoring motion detection...")
    while True:
        if (mode_auto and sun.check_sun_times() == "close") or (not mode_auto and not simulated_daytime):
            motion_handler()
        else:
            time.sleep(2)

def mode_manager():
    global mode_auto
    global simulated_daytime

    print("[MODE] Managing Auto/Manual and Day/Night switches...")

    last_auto_manual_state = GPIO.input(AUTO_MANUAL_SWITCH_PIN)
    last_day_night_state = GPIO.input(DAY_NIGHT_SWITCH_PIN)

    while True:
        current_auto_manual = GPIO.input(AUTO_MANUAL_SWITCH_PIN)
        current_day_night = GPIO.input(DAY_NIGHT_SWITCH_PIN)

        # Auto/Manual switch pressed
        if current_auto_manual != last_auto_manual_state:
            if current_auto_manual == GPIO.LOW:
                mode_auto = not mode_auto
                if mode_auto:
                    print("[MODE] Switched to AUTO Mode")
                    log_event("Mode Switch", "AUTO Mode Activated")
                else:
                    print("[MODE] Switched to MANUAL Mode")
                    log_event("Mode Switch", "MANUAL Mode Activated")
            time.sleep(0.5)
            last_auto_manual_state = current_auto_manual

        # Day/Night switch pressed (only if manual mode)
        if not mode_auto and current_day_night != last_day_night_state:
            if current_day_night == GPIO.LOW:
                simulated_daytime = not simulated_daytime
                if simulated_daytime:
                    print("[MODE] Switched to DAYTIME Simulation")
                    open_coop()
                    log_event("Manual Day Mode", "Coop Opened for Day")
                else:
                    print("[MODE] Switched to NIGHTTIME Simulation")
                    close_coop()
                    log_event("Manual Night Mode", "Coop Closed for Night")
            time.sleep(0.5)
            last_day_night_state = current_day_night

        time.sleep(0.1)

def auto_day_night_cycle():
    print("[AUTO] Starting day/night cycle monitoring...")
    while True:
        if mode_auto:
            if sun.needs_update():
                sun.fetch_sun_times()

            state = sun.check_sun_times()

            if state == "open" and coop_closed:
                open_coop()
            elif state == "close" and not coop_closed:
                close_coop()

        time.sleep(30)

def run_all_modules():
    threads = [
        threading.Thread(target=auto_day_night_cycle),
        threading.Thread(target=combo_counter_monitor),
        threading.Thread(target=motion_monitor),
        threading.Thread(target=mode_manager)
    ]

    for t in threads:
        t.start()

    for t in threads:
        t.join()

# === Main Start ===
if __name__ == "__main__":
    try:
        run_all_modules()
    except KeyboardInterrupt:
        print("[EXIT] Shutting down...")
        GPIO.cleanup()
