import threading
import time
import RPi.GPIO as GPIO
from relay_polarity_control import PolarityRelayController
from relay_stepper_control import RelayStepperController
from motion_sound_system import motion_handler, stop_motion_handler
from event_logger import log_event
from sunset_sunrise_control import SunriseSunsetController

# GPIO Setup
GPIO.setmode(GPIO.BCM)
GPIO.setwarnings(False)

LIMIT_SWITCH_PIN = 23
IR_SENSOR_PIN = 22
AUTO_MANUAL_SWITCH_PIN = 13
DAY_NIGHT_SWITCH_PIN = 4

GPIO.setup(LIMIT_SWITCH_PIN, GPIO.IN, pull_up_down=GPIO.PUD_UP)
GPIO.setup(IR_SENSOR_PIN, GPIO.IN)
GPIO.setup(AUTO_MANUAL_SWITCH_PIN, GPIO.IN, pull_up_down=GPIO.PUD_UP)
GPIO.setup(DAY_NIGHT_SWITCH_PIN, GPIO.IN, pull_up_down=GPIO.PUD_UP)

# Components
actuator = PolarityRelayController()
stepper = RelayStepperController()
sun = SunriseSunsetController()

# Global State
current_mode = "AUTO"  # AUTO or MANUAL
current_time_of_day = "NIGHT"  # DAY or NIGHT
combo_count = 0
motion_thread = None
combo_thread = None

def open_coop():
    print("[COOP] Opening coop (DAYTIME behavior).")
    actuator.retract()
    time.sleep(15)
    actuator.stop()
    stepper.power_on()
    stepper.rotate("cw", 5)
    stepper.power_off()
    log_event("Coop Opened", "DAYTIME")

def close_coop():
    print("[COOP] Closing coop (NIGHTTIME behavior).")
    actuator.extend()
    time.sleep(15)
    actuator.stop()
    stepper.power_on()
    stepper.rotate("ccw", 5)
    stepper.power_off()
    log_event("Coop Closed", "NIGHTTIME")

def combo_counter():
    global combo_count
    print("[COMBO] Combo counter active (DAY).")
    while current_mode == "MANUAL" or current_mode == "AUTO":
        if current_time_of_day != "DAY":
            time.sleep(1)
            continue
        
        ir_triggered = False
        limit_triggered = False
        start_time = time.time()

        while time.time() - start_time < 2:
            if not ir_triggered and GPIO.input(IR_SENSOR_PIN) == GPIO.LOW:
                ir_triggered = True
                print("[COMBO] IR beam broken.")

            if not limit_triggered and GPIO.input(LIMIT_SWITCH_PIN) == GPIO.LOW:
                limit_triggered = True
                print("[COMBO] Limit Switch triggered.")

            if ir_triggered and limit_triggered:
                combo_count += 1
                print(f"[COMBO] Chicken detected! Total: {combo_count}")
                log_event("Combo Chicken Count", f"Combo Count: {combo_count}")
                break

            time.sleep(0.05)

        time.sleep(0.2)

def day_behavior():
    open_coop()
    start_combo_counter()

def night_behavior():
    close_coop()
    start_motion_handler()

def start_motion_handler():
    global motion_thread
    if motion_thread and motion_thread.is_alive():
        print("[MOTION] Already running.")
        return
    print("[MOTION] Starting motion handler...")
    motion_thread = threading.Thread(target=motion_handler)
    motion_thread.daemon = True
    motion_thread.start()

def stop_motion():
    print("[MOTION] Stopping motion handler...")
    stop_motion_handler()

def start_combo_counter():
    global combo_thread
    if combo_thread and combo_thread.is_alive():
        print("[COMBO] Already running.")
        return
    print("[COMBO] Starting combo counter...")
    combo_thread = threading.Thread(target=combo_counter)
    combo_thread.daemon = True
    combo_thread.start()

def stop_combo_counter():
    global combo_thread
    if combo_thread:
        print("[COMBO] Stopping combo counter (it will exit naturally).")

def check_day_night_status():
    if current_mode == "AUTO":
        state = sun.check_sun_times()
    else:
        if GPIO.input(DAY_NIGHT_SWITCH_PIN) == GPIO.LOW:
            state = "open"
        else:
            state = "close"

    return "DAY" if state == "open" else "NIGHT"

def monitor_mode_switch():
    global current_mode
    while True:
        if GPIO.input(AUTO_MANUAL_SWITCH_PIN) == GPIO.LOW:
            if current_mode != "MANUAL":
                current_mode = "MANUAL"
                print("[MODE] Switched to MANUAL Mode.")
                log_event("Mode Switch", "MANUAL")
        else:
            if current_mode != "AUTO":
                current_mode = "AUTO"
                print("[MODE] Switched to AUTO Mode.")
                log_event("Mode Switch", "AUTO")

        time.sleep(0.5)

def main_loop():
    global current_time_of_day
    sun.fetch_sun_times()
    last_known_time = None

    while True:
        time_now = check_day_night_status()

        if time_now != last_known_time:
            last_known_time = time_now
            current_time_of_day = time_now

            if current_time_of_day == "DAY":
                stop_motion()
                day_behavior()
            elif current_time_of_day == "NIGHT":
                stop_combo_counter()
                night_behavior()

        time.sleep(2)

def setup():
    actuator.stop()
    stepper.power_off()
    print("[SYSTEM] System initialized. Relays OFF.")
    log_event("System Startup", "")

if __name__ == "__main__":
    try:
        setup()
        threading.Thread(target=monitor_mode_switch, daemon=True).start()
        main_loop()
    except KeyboardInterrupt:
        print("[SYSTEM] Shutting down.")
        actuator.stop()
        stepper.power_off()
        stop_motion()
        GPIO.cleanup()
